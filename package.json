{
    "name": "@jiovan-labs/ts-multi-map",
    "version": "2.0.0",
    "title": "Typescript Multiple Map",
    "description": "Multiple key/value map & range map for typescript",
    "homepage": "https://jiovan-labs.github.io/ts-multi-map",
    "organization": "Jiovan Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "multi-map",
        "multiple-map",
        "many-keys-map",
        "many-values-map",
        "range-map",
        "readonly-multi-map",
        "readonly-multiple-map",
        "readonly-many-keys-map",
        "readonly-many-values-map",
        "readonly-range-map"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "unpkg": "dist/umd/ts-multi-map.min.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": false,
    "scripts": {
        "approve": "npm approve-scripts --allow-scripts-pending",
        "build": "del-cli ./dist && father build",
        "build:doctor": "father doctor",
        "build:watch": "father dev",
        "docs:build": "typedoc --out ./docs-dist",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "lint:fix": "eslint --fix \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "test": "jest",
        "test:coverage": "del-cli ./coverage && jest --coverage --coverageDirectory ./coverage",
        "upgrade": "npx npm-check-updates --target semver -u"
    },
    "dependencies": {
        "@babel/runtime": "^7.29.10",
        "object-hash": "^3.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.9.9",
        "@types/object-hash": "^3.0.6",
        "@jiovan-labs/babel-plugin-remove-comment": "^2.0.0",
        "@jiovan-labs/typedoc-plugin-raw-content": "^2.0.0",
        "@jiovan-labs/typedoc-theme-dumi": "^2.0.0",
        "del-cli": "^7.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-jest": "^29.17.0",
        "father": "^4.6.41",
        "gh-pages": "^6.3.0",
        "globals": "^17.14.0",
        "ts-jest": "^29.4.15",
        "typedoc": "~0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "peerDependencies": {
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/joivan-labs/ts-multi-map.git"
    },
    "bugs": {
        "url": "https://github.com/joivan-labs/ts-multi-map/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/joivan-labs"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/joivan-labs"
        },
        {
            "type": "individual",
            "url": "https://joivan.com/donation"
        }
    ],
    "author": {
        "name": "Jiovan Ltd",
        "url": "https://joivan.com"
    },
    "contributors": [
        {
            "name": "David Hsing",
            "email": "davidhsing@163.com",
            "url": "https://github.com/davidhsing"
        }
    ],
    "allowScripts": {
        "core-js": true,
        "core-js-pure": true,
        "esbuild": true,
        "fsevents": true,
        "unrs-resolver": true
    }
}
